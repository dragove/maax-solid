{
  "name": "maax-solid",
  "version": "0.1.0",
  "private": true,
  "description": "A modern desktop client for MaaAssistantArknights, built with Electron 44, Solid 2 and Effect 4.",
  "license": "AGPL-3.0-or-later",
  "author": "Maax",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run format:check",
    "build": "pnpm run lint && electron-vite build",
    "package": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "bench:startup": "node scripts/measure-startup.mjs"
  },
  "dependencies": {
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.56.0",
    "@effect/vitest": "4.0.6",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@solidjs/web": "2.0.0-rc.17",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "effect": "4.0.6",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide": "1.59.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "semver": "7.8.5",
    "solid-js": "2.0.0-rc.17",
    "typescript": "7.1.0-beta",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.0.0 <13"
  },
  "packageManager": "pnpm@12.15.0",
  "productName": "Maax"
}
