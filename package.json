{
  "name": "maax-solid",
  "version": "0.2.0",
  "private": true,
  "description": "A modern desktop client for MaaAssistantArknights, built with Electron 45, Solid 2 and Effect 4.",
  "license": "AGPL-3.0-or-later",
  "author": "Maax",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "prepare": "node scripts/prepare.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run format:check",
    "typecheck": "tsrs -p tsconfig.node.json --noEmit && tsrs -p tsconfig.web.json --noEmit",
    "build": "pnpm run lint && electron-vite build",
    "package": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "dist:release": "pnpm run build && electron-builder --linux && node scripts/archive-linux.mjs",
    "bench:startup": "node scripts/measure-startup.mjs"
  },
  "dependencies": {
    "koffi": "3.3.7"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.2",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "^2.0.0-rc.21",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "@vitest/browser-playwright": "5.1.0",
    "effect": "4.1.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide": "1.70.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "semver": "7.8.6",
    "solid-js": "^2.0.0-rc.21",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.0.0 <13"
  },
  "packageManager": "pnpm@12.18.0",
  "productName": "Maax"
}
